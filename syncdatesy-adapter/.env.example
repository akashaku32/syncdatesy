SECRET_KEY=change-me-to-a-long-random-string
INTERNAL_API_KEY=change-me-shared-internal-service-token
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/datasyncher
FIELD_ENCRYPTION_KEY=change-me-base64-or-long-random-master-key
FIELD_ENCRYPTION_KEY_VERSION=1
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Proxy agent (SAP) — CA paths for cert issuance; public host for progress_api_url
PROXY_AGENT_CA_CERT_PATH=
PROXY_AGENT_CA_KEY_PATH=
PROXY_AGENT_PUBLIC_API_HOST=agent-api.datasyncher.com
# grpc (primary), grpc_with_https_fallback (default), or https (HTTPS-only fallback mode)
PROXY_AGENT_PROGRESS_TRANSPORT=grpc_with_https_fallback
PROXY_AGENT_SERVER_HOST=qa.datasyncher.com
PROXY_AGENT_SERVER_PORT=50051
DJANGO_INTERNAL_BASE_URL=http://django-svc:8000
